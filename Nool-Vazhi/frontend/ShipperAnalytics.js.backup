"import { useState, useEffect } from 'react';\nimport Sidebar from '../components/Sidebar';\nimport { shipmentAPI } from '../api';\nimport { BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer, LineChart, Line } from 'recharts';\n\nexport default function ShipperAnalytics() {\n  const [data, setData] = useState(null);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    shipmentAPI.getShipperAnalytics()\n      .then(res => setData(res.data))\n      .catch(console.error)\n      .finally(() => setLoading(false));\n  }, []);\n\n  const content = (\n    <main style={styles.main}>\n      <div style={styles.header}>\n        <h1 style={styles.title}>Analytics <span style={{ color: '#F97316' }}>Dashboard</span></h1>\n        <p style={styles.sub}>Track your spending, savings, and top routes</p>\n      </div>\n\n      {loading ? (\n        <div style={styles.empty}><i className=\"fa-solid fa-spinner fa-spin\" style={{ fontSize: 32, color: '#cbd5e1' }}></i></div>\n      ) : !data ? (\n        <div style={styles.empty}>Failed to load analytics data.</div>\n      ) : (\n        <>\n          <div className=\"grid-3\" style={{ marginBottom: 30 }}>\n            <div className=\"card\" style={styles.summaryCard}>\n              <div style={{ ...styles.summaryIcon, background: '#e0e7ff', color: '#4f46e5' }}><i className=\"fa-solid fa-indian-rupee-sign\"></i></div>\n              <div style={styles.summaryLabel}>Total Spend</div>\n              <div style={{ ...styles.summaryValue, color: '#4f46e5' }}>₹{data.totalSpent?.toLocaleString()}</div>\n            </div>\n            <div className=\"card\" style={styles.summaryCard}>\n              <div style={{ ...styles.summaryIcon, background: '#dcfce7', color: '#16a34a' }}><i className=\"fa-solid fa-piggy-bank\"></i></div>\n              <div style={styles.summaryLabel}>Total Savings (Pool)</div>\n              <div style={{ ...styles.summaryValue, color: '#16a34a' }}>₹{data.totalSavings?.toLocaleString()}</div>\n            
<truncated 4786 bytes>